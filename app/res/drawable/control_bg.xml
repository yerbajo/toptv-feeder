<?xml version="1.0" encoding="utf-8"?>
<!-- A D-pad focus has to be obvious on a TV two metres away: the focused control
     fills with the accent colour instead of only changing its outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/control_bg" />
            <stroke android:width="1dp" android:color="@color/control_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
